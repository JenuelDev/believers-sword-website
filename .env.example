SUPABASE_URL=
SUPABASE_KEY=

# Only needed for `pnpm db:sql` (running .sql files against the database).
# Supabase dashboard -> Connect button (top of the project) -> Shared Pooler,
# Session mode, port 5432. Note the username is postgres.<project-ref>.
# Do NOT use the direct db.<project-ref>.supabase.co host: it is IPv6-only and
# will not connect from an IPv4-only network.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres
